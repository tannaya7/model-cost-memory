      "RunAccepted": {
        "properties": {
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "description": "'duplicate' means this run_id was already recorded; nothing changed",
            "enum": [
              "accepted",
              "duplicate"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "title": "RunAccepted",
        "type": "object"
      },
      "RunCreate": {
        "description": "One model call, sent by the SDK (or any client) after the production call has finished.\n\n`run_id` is generated by the sender, so a retried send is recognised as the same run and never\ncounted twice. The outcome (pass or fail) is never accepted from the client: it is resolved here.",
        "properties": {
          "cache_read_tokens": {
            "default": 0,
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Cache Read Tokens",
            "type": "integer"
          },
          "cache_write_tokens": {
            "default": 0,
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Cache Write Tokens",
            "type": "integer"
          },
          "cost_usd": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Used only when the model catalog has no price; otherwise the server computes it",
            "title": "Cost Usd"
          },
          "expected": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The correct values for an ANSWER_KEY job, used to check this run and not stored",
            "title": "Expected"
          },
          "job": {
            "description": "Name of an existing job in this project",
            "title": "Job",
            "type": "string"
          },
          "latency_ms": {
            "anyOf": [
              {
                "maximum": 3600000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "model": {
            "description": "The model the call asked for",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "model_version": {
            "description": "The provider-resolved version from the response",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "prompt": {
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "prompt_version": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "tokens_in": {
            "default": 0,
            "description": "Uncached input tokens",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Tokens In",
            "type": "integer"
          },
          "tokens_out": {
            "default": 0,
            "description": "Output tokens, thinking included",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Tokens Out",
            "type": "integer"
          },
          "tool_calls": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "maxItems": 100,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only each tool's name and call id are kept. Arguments are dropped unless the project has opted in to storing them, because they can hold sensitive data.",
            "title": "Tool Calls"
          }
        },
        "required": [
          "run_id",
          "job",
          "prompt",
          "model",
          "model_version"
        ],
        "title": "RunCreate",
        "type": "object"
      },
