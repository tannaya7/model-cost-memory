{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "JobCreate": {
        "description": "Define a job and how a correct answer is recognised.",
        "properties": {
          "check_config": {
            "additionalProperties": true,
            "description": "ANSWER_KEY: {'fields': [...]}. SCHEMA: {'schema': <JSON Schema>}.",
            "title": "Check Config",
            "type": "object"
          },
          "check_kind": {
            "enum": [
              "ANSWER_KEY",
              "TEST_COMMAND",
              "SCHEMA",
              "LATE_LABEL"
            ],
            "title": "Check Kind",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "examples": [
              "invoice-extract"
            ],
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Name",
            "type": "string"
          },
          "retest_consent": {
            "default": false,
            "description": "May this job's prompts be replayed on another provider?",
            "title": "Retest Consent",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "check_kind"
        ],
        "title": "JobCreate",
        "type": "object"
      },
      "JobOut": {
        "properties": {
          "check_config": {
            "additionalProperties": true,
            "title": "Check Config",
            "type": "object"
          },
          "check_kind": {
            "enum": [
              "ANSWER_KEY",
              "TEST_COMMAND",
              "SCHEMA",
              "LATE_LABEL"
            ],
            "title": "Check Kind",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "retest_consent": {
            "title": "Retest Consent",
            "type": "boolean"
          },
          "run_count": {
            "description": "All runs recorded for this job",
            "title": "Run Count",
            "type": "integer"
          },
          "runs_by_state": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Run counts per state, for example {'INDEXED': 40}",
            "title": "Runs By State",
            "type": "object"
          }
        },
        "required": [
          "job_id",
          "name",
          "description",
          "check_kind",
          "check_config",
          "retest_consent",
          "run_count"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "LabelCreate": {
        "description": "A late outcome for a run that was stored UNKNOWN.",
        "properties": {
          "outcome": {
            "enum": [
              "PASS",
              "FAIL"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "outcome"
        ],
        "title": "LabelCreate",
        "type": "object"
      },
      "ModelOut": {
        "description": "One model in the catalog.",
        "properties": {
          "first_seen_at": {
            "format": "date-time",
            "title": "First Seen At",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "price_in_per_mtok": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "US dollars per million input tokens",
            "title": "Price In Per Mtok"
          },
          "price_out_per_mtok": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "US dollars per million output tokens",
            "title": "Price Out Per Mtok"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "shutdown_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Announced shutdown, set while DEPRECATED",
            "title": "Shutdown Date"
          },
          "source": {
            "description": "MANUAL rows are overrides the daily sync never changes",
            "enum": [
              "SYNC",
              "MANUAL"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "description": "RETIRED models are never recommended",
            "enum": [
              "ACTIVE",
              "DEPRECATED",
              "RETIRED"
            ],
            "title": "Status",
            "type": "string"
          },
          "used_by_project": {
            "description": "This project has recorded runs on this model",
            "title": "Used By Project",
            "type": "boolean"
          }
        },
        "required": [
          "model",
          "model_version",
          "provider",
          "status",
          "shutdown_date",
          "price_in_per_mtok",
          "price_out_per_mtok",
          "source",
          "first_seen_at",
          "used_by_project"
        ],
        "title": "ModelOut",
        "type": "object"
      },
