# Copy to .env and fill in. Never commit .env.
# Development uses a free hosted Neon PostgreSQL (with pgvector); use its direct, non-pooled URL for
# migrations. On the server, docker-compose overrides DATABASE_URL to use the host name `db`.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require   # your Neon connection string
DB_POOL_SIZE=3                 # connections per process, plus...
DB_MAX_OVERFLOW=2              # ...this many in bursts: 4 processes use at most 20

# Encrypts stored provider keys and signs the sign-in cookie. Required on a server; any long random
# string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))". Changing it signs everyone
# out and makes stored provider keys unreadable (they must be entered again).
SECRET_KEY=

# --- Model access ---
# Demo data and our own demo re-tests use a free hosted tier (decided 26 Oct): Gemini and/or Groq,
# both OpenAI-compatible, so scripts/run_corpus.py needs only --base-url and --api-key-env.
GEMINI_API_KEY=                 # https://aistudio.google.com  (base URL .../v1beta/openai/)
GROQ_API_KEY=                   # https://console.groq.com     (base URL https://api.groq.com/openai/v1)
# Optional two-sentence recommendation summary (Claude). Leave empty to switch it off.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5

# --- Recommendation and decay ---
EVIDENCE_FLOOR=25
TOLERANCE_POINTS=0.03          # a cheaper model may be at most this much worse...
CONFIDENCE_LEVEL=0.95          # ...with this much confidence
VERSION_FACTOR_SUPERSEDED=0.25
CATALOG_SOURCE_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json

# --- Regression detection (a drop is flagged when p < alpha AND it is at least the minimum) ---
REGRESSION_ALPHA=0.05
REGRESSION_MIN_DROP=0.05
REGRESSION_MIN_RUNS=30

# --- Re-tests (always capped; the customer's own key, asked for when first needed) ---
RETEST_MONTHLY_CAP_USD=10      # default cap for new projects; each project can change its own
RETEST_CONCURRENCY=2           # calls at once: low, because a free key shares its quota with production
RETEST_DEFAULT_SAMPLE=50       # prompts replayed per re-test
RETEST_AUTO_BUDGET_USD=1       # budget of a re-test the system starts on its own

# --- Sign-in (Google). Without a client id, people use a project key instead. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:5174   # where the web app is served; Google redirects to PUBLIC_URL/auth/google/callback
DEV_LOGIN=false                    # local development only: sign in by email without Google. Never true on a server
DEMO_PROJECT_ID=                   # a project anyone may read without signing in (see scripts/seed_demo.py)

# --- Server only (docker-compose) ---
POSTGRES_PASSWORD=                # a strong password for the database container
DOMAIN=                           # the domain name that points at the server, for HTTPS
