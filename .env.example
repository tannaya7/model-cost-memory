# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory
NEO4J_URL=                      # optional; empty = lineage disabled (NullGraphStore)
ANTHROPIC_API_KEY=              # re-tests and corpus building only
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1   # local models through the openai client
RETEST_MONTHLY_CAP_USD=10
EVIDENCE_FLOOR=25
VERSION_FACTOR_SUPERSEDED=0.25
CATALOG_SOURCE_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
