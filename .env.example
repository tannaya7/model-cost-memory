# Copy to .env and fill in. Never commit .env.
# Development uses a free hosted Neon PostgreSQL (with pgvector); use its direct, non-pooled URL for
# migrations. On the server, docker-compose overrides DATABASE_URL to use the host name `db`.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require   # your Neon connection string
ANTHROPIC_API_KEY=              # re-tests and corpus building only
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1   # local models through the openai client
RETEST_MONTHLY_CAP_USD=10
EVIDENCE_FLOOR=25
VERSION_FACTOR_SUPERSEDED=0.25
CATALOG_SOURCE_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
